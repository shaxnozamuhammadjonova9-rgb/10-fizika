function drawBall(){fit(ballCanvas,bctx);let w=ballCanvas.clientWidth,h=300,cx=w/2,cy=h/2,R=+document.getElementById('ballRadius').value,v=+document.getElementById('ballSpeed').value;let x,y;if(!cut){x=cx+R*Math.cos(bt);y=cy+R*Math.sin(bt);px=x;py=y;}else{x=px; y=py;}bctx.strokeStyle='#cbd5e1';bctx.lineWidth=2;bctx.beginPath();bctx.arc(cx,cy,R,0,Math.PI*2);bctx.stroke();bctx.fillStyle='#64748b';bctx.beginPath();bctx.arc(cx,cy,5,0,Math.PI*2);bctx.fill();if(!cut){bctx.strokeStyle='#8b5cf6';bctx.lineWidth=3;bctx.beginPath();bctx.moveTo(cx,cy);bctx.lineTo(x,y);bctx.stroke();arrow(bctx,x,y,cx,cy,'#16a34a','T / Fm');arrow(bctx,x,y,x-48*Math.sin(bt),y+48*Math.cos(bt),'#ef4444','v');}else{arrow(bctx,x,y,x+pvx*2,y+pvy*2,'#ef4444','v');if(ballRun){px+=pvx;py+=pvy;}}bctx.fillStyle='#2563eb';bctx.beginPath();bctx.arc(x,y,13,0,Math.PI*2);bctx.fill();document.getElementById('ballSpeedVal').textContent=v;document.getElementById('ballRadiusVal').textContent=R+' px';document.getElementById('ballResult').textContent=cut?'Ip uzildi: shar urinma yo‘nalishda harakatlanadi.':`Markazga intilma kuch markaz tomon yo‘nalgan. Tezlik v=${v} (shartli birlik).`;if(ballRun&&!cut)bt+=v*.012;requestAnimationFrame(drawBall)}
function toggleBall(){ballRun=!ballRun}function cutString(){if(!cut){let v=+document.getElementById('ballSpeed').value;pvx=-Math.sin(bt)*v*.7;pvy=Math.cos(bt)*v*.7;cut=true;ballRun=true}}function resetBall(){cut=false;bt=0;ballRun=true}
